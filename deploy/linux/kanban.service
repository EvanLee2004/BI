# 甲骨易经营看板 · systemd 单元（Ubuntu 26.04 · 任务书50）
# 安装见 docs/Ubuntu部署手册.md；模板内路径按实际部署目录改。
# 生产：配合 nginx-kanban.conf，本服务仅绑 127.0.0.1:8018。
#
# 语义（3.6.0）：
#   - Restart=on-failure + RestartSec=3：仅异常退出再起；正常 stop / TERM(143) 不算崩溃
#   - ExecStart 走 start_with_rollback.sh：码 42 更新重启；TERM/0 直接退出交 systemd
#   - StartLimitBurst=5 / StartLimitIntervalSec=120：短时反复崩则停下
#     注意：StartLimit* 必须在 [Unit]（Ubuntu 26 / systemd 新版放 [Service] 会被忽略）
#
# 安装示例（部署目录=/opt/kanban/看板正式程序）：
#   生产机实际 User/Group=lee（数据目录属主）；模板默认也用 lee，勿盲改 kanban 除非先 chown。
#   sudo cp deploy/linux/kanban.service /etc/systemd/system/kanban.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now kanban
#   journalctl -u kanban -f

[Unit]
Description=甲骨易经营看板 (kanban)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=lee
Group=lee
WorkingDirectory=/opt/kanban/看板正式程序
# 包装脚本：42 更新重启 / 回滚；TERM/0 不累计崩溃。systemd 为唯一失败监督者
ExecStart=/bin/bash /opt/kanban/看板正式程序/deploy/linux/start_with_rollback.sh
Restart=on-failure
RestartSec=3
# 日志走 journald：journalctl -u kanban -n 200 --no-pager
StandardOutput=journal
StandardError=journal
# 环境：UTF-8 兜底（中文路径/日志）
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
# nginx 反代生产：后端只绑回环、不挂 static（由 nginx :80 伺服）
Environment=KANBAN_SERVER_HOST=127.0.0.1
Environment=KANBAN_SERVE_STATIC=0
# OPS-001：代码读 KANBAN_PORT（非 KANBAN_SERVER_PORT）
Environment=KANBAN_PORT=8018
# 3.7.15 CIFS B：管理端改密走 sudo 固定脚本（见 sudoers.d-kanban-cifs）
Environment=KANBAN_CIFS_USE_SUDO=1
Environment=KANBAN_CIFS_APPLY_SCRIPT=/usr/local/sbin/kanban-cifs-apply
# 离线抓数开关可由本地配置控制；此处不强行设 KANBAN_OFFLINE
# 任务书64·D8：进程沙箱（ReadWritePaths 须含程序/数据/日志/备份/归档 + 用户运行时）
# 3.7.15：NoNewPrivileges=false —— 否则 sudo -n 无法提权写 /etc/kanban/cifs-ledger.cred / remount
# （仍靠 sudoers 只放行单一脚本，禁止任意 shell）
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/kanban/看板正式程序 /opt/kanban/看板正式程序/数据 /opt/kanban/看板正式程序/数据/日志 /opt/kanban/看板正式程序/数据/备份 /opt/kanban/看板正式程序/数据/年度归档 /run/user/1000 /home/lee
# 3.7.14/3.7.15：CIFS 挂载点 + cred 目录（挂载后可读台账；apply 经 sudo 写 cred）
ReadWritePaths=/mnt/kanban-ledger /etc/kanban

[Install]
WantedBy=multi-user.target
